<Window x:Class="GrandArchive.GUI.DeckBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deck Builder - Grand Archive TCG" 
        Height="900" Width="1400"
        MinHeight="700" MinWidth="1200"
        Background="{StaticResource PrimaryDarkBrush}"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryDarkBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DECK BUILDER" FontSize="20" FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Deck Name -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Deck Name:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" 
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="DeckNameTextBox" Width="300" Text="New Deck" 
                             Background="{StaticResource TertiaryDarkBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="8,6" FontSize="14"/>
                </StackPanel>
                
                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ImportListButton" Content="Import Text" Style="{StaticResource GameButton}" 
                            Click="ImportListButton_Click" Margin="0,0,8,0"/>
                    <Button x:Name="LoadDeckButton" Content="Load Deck" Style="{StaticResource GameButton}" 
                            Click="LoadDeckButton_Click" Margin="0,0,8,0"/>
                    <Button x:Name="SaveDeckButton" Content="Save Deck" Style="{StaticResource GameButton}" 
                            Click="SaveDeckButton_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ConfirmDeckButton" Content="Use Deck" Style="{StaticResource ActionButton}" 
                            Click="ConfirmDeckButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left: Card Browser -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Search and Filters -->
                <Border Grid.Row="0" Background="{StaticResource SecondaryDarkBrush}" 
                        CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="SearchTextBox" Grid.Column="0"
                                     Background="{StaticResource TertiaryDarkBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     Padding="10,8" FontSize="14"
                                     TextChanged="SearchTextBox_TextChanged">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Resources>
                                            <VisualBrush x:Key="PlaceholderBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Search cards..." Foreground="#8B949E" Margin="12,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Style.Resources>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background" Value="{StaticResource PlaceholderBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            
                            <Button x:Name="ClearSearchButton" Grid.Column="1" Content="Clear" 
                                    Style="{StaticResource GameButton}" Margin="8,0,0,0"
                                    Click="ClearSearchButton_Click"/>
                        </Grid>
                        
                        <!-- Filter Tabs -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <RadioButton x:Name="FilterAll" Content="All" GroupName="CardFilter" 
                                         IsChecked="True" Checked="Filter_Changed"
                                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"/>
                            <RadioButton x:Name="FilterMainDeck" Content="Main Deck Cards" GroupName="CardFilter" 
                                         Checked="Filter_Changed"
                                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"/>
                            <RadioButton x:Name="FilterRegalia" Content="Regalia" GroupName="CardFilter" 
                                         Checked="Filter_Changed"
                                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"/>
                            <RadioButton x:Name="FilterChampions" Content="Champions" GroupName="CardFilter" 
                                         Checked="Filter_Changed"
                                         Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        
                        <!-- Element Filter -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Element:" Foreground="{StaticResource TextSecondaryBrush}" 
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ElementFilter" Width="120" 
                                      Background="{StaticResource TertiaryDarkBrush}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      SelectionChanged="ElementFilter_SelectionChanged">
                                <ComboBoxItem Content="All" IsSelected="True"/>
                                <ComboBoxItem Content="FIRE"/>
                                <ComboBoxItem Content="WATER"/>
                                <ComboBoxItem Content="WIND"/>
                                <ComboBoxItem Content="ARCANE"/>
                                <ComboBoxItem Content="NORM"/>
                                <ComboBoxItem Content="LUXEM"/>
                                <ComboBoxItem Content="UMBRA"/>
                                <ComboBoxItem Content="ASTRA"/>
                                <ComboBoxItem Content="CRUX"/>
                                <ComboBoxItem Content="TERA"/>
                            </ComboBox>
                            
                            <TextBlock Text="Type:" Foreground="{StaticResource TextSecondaryBrush}" 
                                       VerticalAlignment="Center" Margin="24,0,8,0"/>
                            <ComboBox x:Name="TypeFilter" Width="120" 
                                      Background="{StaticResource TertiaryDarkBrush}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      SelectionChanged="TypeFilter_SelectionChanged">
                                <ComboBoxItem Content="All" IsSelected="True"/>
                                <ComboBoxItem Content="CHAMPION"/>
                                <ComboBoxItem Content="ALLY"/>
                                <ComboBoxItem Content="ACTION"/>
                                <ComboBoxItem Content="ATTACK"/>
                                <ComboBoxItem Content="ITEM"/>
                                <ComboBoxItem Content="WEAPON"/>
                                <ComboBoxItem Content="REGALIA"/>
                                <ComboBoxItem Content="DOMAIN"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Results Count -->
                <TextBlock Grid.Row="1" x:Name="ResultsCountText" Text="0 cards found" 
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" 
                           Margin="4,0,0,8"/>
                
                <!-- Card List -->
                <Border Grid.Row="2" Background="{StaticResource SecondaryDarkBrush}" 
                        CornerRadius="8" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CardBrowserPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
            
            <!-- Right: Deck Lists -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Material Deck Header -->
                <Border Grid.Row="0" Background="{StaticResource AccentPurpleBrush}" 
                        CornerRadius="8,8,0,0" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MATERIAL DECK" FontSize="14" FontWeight="Bold" 
                                       Foreground="White"/>
                            <TextBlock x:Name="MaterialDeckInfo" Text="0/12 material cards" 
                                       FontSize="10" Foreground="White" Opacity="0.8"/>
                        </StackPanel>
                        <Button x:Name="ClearMaterialDeckButton" Grid.Column="1" Content="Clear" 
                                Style="{StaticResource GameButton}" Padding="8,4"
                                Click="ClearMaterialDeckButton_Click"/>
                    </Grid>
                </Border>
                
                <!-- Material Deck List -->
                <Border Grid.Row="1" Background="{StaticResource SecondaryDarkBrush}" 
                        BorderBrush="{StaticResource AccentPurpleBrush}" BorderThickness="1,0,1,1"
                        CornerRadius="0,0,8,8" Padding="8" Margin="0,0,0,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MaterialDeckPanel"/>
                    </ScrollViewer>
                </Border>
                
                <!-- Main Deck Header -->
                <Border Grid.Row="2" Background="{StaticResource AccentGoldBrush}" 
                        CornerRadius="8,8,0,0" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MAIN DECK" FontSize="14" FontWeight="Bold" 
                                       Foreground="White"/>
                            <TextBlock x:Name="MainDeckInfo" Text="0/60 cards (min 60)" 
                                       FontSize="10" Foreground="White" Opacity="0.8"/>
                        </StackPanel>
                        <Button x:Name="ClearMainDeckButton" Grid.Column="1" Content="Clear" 
                                Style="{StaticResource GameButton}" Padding="8,4"
                                Click="ClearMainDeckButton_Click"/>
                    </Grid>
                </Border>
                
                <!-- Main Deck List -->
                <Border Grid.Row="3" Background="{StaticResource SecondaryDarkBrush}" 
                        BorderBrush="{StaticResource AccentGoldBrush}" BorderThickness="1,0,1,1"
                        CornerRadius="0,0,8,8" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MainDeckPanel"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
        
        <!-- Footer: Validation Status -->
        <Border Grid.Row="2" Background="{StaticResource SecondaryDarkBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Validation Messages -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border x:Name="ValidationStatusBorder" CornerRadius="4" Padding="12,6" 
                            Background="{StaticResource TertiaryDarkBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ValidationIcon" Text="⚠" FontSize="14" 
                                       Foreground="{StaticResource AccentRedBrush}" 
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ValidationText" Text="Deck is incomplete" 
                                       FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Deck Stats -->
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                        <Border Background="{StaticResource TertiaryDarkBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Divine Relics: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="DivineRelicCount" Text="0/1" FontSize="11" 
                                           Foreground="{StaticResource AccentGoldBrush}" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource TertiaryDarkBrush}" CornerRadius="4" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Champion Spirits: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="ChampionSpiritCount" Text="0 (need 1+)" FontSize="11" 
                                           Foreground="{StaticResource AccentBlueBrush}" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
                
                <!-- Card Preview Info -->
                <Border Grid.Column="1" x:Name="HoverPreviewPanel" Visibility="Collapsed"
                        Background="{StaticResource TertiaryDarkBrush}" CornerRadius="8" Padding="12">
                    <StackPanel Orientation="Horizontal" MaxWidth="400">
                        <Image x:Name="HoverPreviewImage" Width="60" Height="84" 
                               Stretch="UniformToFill" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center" MaxWidth="300">
                            <TextBlock x:Name="HoverPreviewName" Text="" FontSize="12" FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="HoverPreviewType" Text="" FontSize="10" 
                                       Foreground="{StaticResource AccentPurpleBrush}"/>
                            <TextBlock x:Name="HoverPreviewEffect" Text="" FontSize="9" 
                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
