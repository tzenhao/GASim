<Window x:Class="GrandArchive.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GrandArchive.GUI"
        Title="Grand Archive TCG Simulator" 
        Height="1080" Width="1920"
        MinHeight="700" MinWidth="1400"
        Background="{StaticResource PrimaryDarkBrush}"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryDarkBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Logo/Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚔" FontSize="24" Foreground="{StaticResource AccentGoldBrush}" 
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="GRAND ARCHIVE" FontSize="20" FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="TCG SIMULATOR" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" 
                               VerticalAlignment="Center" Margin="10,0,0,4"/>
                </StackPanel>
                
                <!-- Game Info -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{StaticResource TertiaryDarkBrush}" CornerRadius="6" Padding="12,6" Margin="8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TURN" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" 
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TurnNumberText" Text="1" FontSize="18" FontWeight="Bold" 
                                       Foreground="{StaticResource AccentGoldBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource TertiaryDarkBrush}" CornerRadius="6" Padding="12,6" Margin="8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶" FontSize="12" Foreground="{StaticResource AccentGreenBrush}" 
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TurnPlayerText" Text="Player 1's Turn" FontSize="14" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NewGameButton" Content="New Game" Style="{StaticResource ActionButton}" 
                            Click="NewGameButton_Click" Margin="0,0,8,0"/>
                    <Button x:Name="NextPhaseButton" Content="Next Phase →" Style="{StaticResource GameButton}" 
                            Click="NextPhaseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content Area with 3 columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>
            
            <!-- LEFT PANEL: Phase Indicator -->
            <Border Grid.Column="0" Background="{StaticResource SecondaryDarkBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,16">
                        <TextBlock Text="PHASES" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        
                        <!-- Wake Up Phase -->
                        <Border x:Name="PhaseWakeUp" CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Cursor="Hand"
                                MouseLeftButtonDown="Phase_Click" Tag="WakeUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource TertiaryDarkBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PhaseWakeUpIndicator" Text="○" FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Wake Up" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Ready rested cards" FontSize="9" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="20,2,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Materialize Phase -->
                        <Border x:Name="PhaseMaterialize" CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Cursor="Hand"
                                MouseLeftButtonDown="Phase_Click" Tag="Materialize">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource TertiaryDarkBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PhaseMaterializeIndicator" Text="○" FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Materialize" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Play from material deck" FontSize="9" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="20,2,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Recollection Phase -->
                        <Border x:Name="PhaseRecollection" CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Cursor="Hand"
                                MouseLeftButtonDown="Phase_Click" Tag="Recollection">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource TertiaryDarkBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PhaseRecollectionIndicator" Text="○" FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Recollection" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Return memory to hand" FontSize="9" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="20,2,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Draw Phase -->
                        <Border x:Name="PhaseDraw" CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Cursor="Hand"
                                MouseLeftButtonDown="Phase_Click" Tag="Draw">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource TertiaryDarkBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PhaseDrawIndicator" Text="○" FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Draw" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Draw a card" FontSize="9" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="20,2,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Main Phase -->
                        <Border x:Name="PhaseMain" CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Cursor="Hand"
                                MouseLeftButtonDown="Phase_Click" Tag="Main">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource TertiaryDarkBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PhaseMainIndicator" Text="○" FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Main Phase" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Play cards, activate abilities" FontSize="9" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="20,2,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Combat Phase -->
                        <Border x:Name="PhaseCombat" CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Cursor="Hand"
                                MouseLeftButtonDown="Phase_Click" Tag="Combat">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource TertiaryDarkBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PhaseCombatIndicator" Text="○" FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Combat" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Attack with units" FontSize="9" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="20,2,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- End Phase -->
                        <Border x:Name="PhaseEnd" CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Cursor="Hand"
                                MouseLeftButtonDown="Phase_Click" Tag="End">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource TertiaryDarkBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PhaseEndIndicator" Text="○" FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="End Phase" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Discard to hand size" FontSize="9" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="20,2,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <Separator Margin="0,12" Background="{StaticResource BorderBrush}"/>
                        
                        <!-- Action Buttons -->
                        <Button x:Name="PassButton" Content="Pass Priority" Style="{StaticResource GameButton}" 
                                Click="PassButton_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                        <Button x:Name="DrawCardButton" Content="Draw Card" Style="{StaticResource GameButton}" 
                                Click="DrawCardButton_Click" HorizontalAlignment="Stretch"/>
                        
                        <Separator Margin="0,12" Background="{StaticResource BorderBrush}"/>
                        
                        <!-- Stack Info -->
                        <TextBlock Text="STACK" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Border Background="{StaticResource TertiaryDarkBrush}" CornerRadius="6" Padding="10,8">
                            <TextBlock x:Name="StackCountText" Text="Empty" FontSize="12" 
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- CENTER: Game Board -->
            <Grid Grid.Column="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Opponent Area (Top) - Mirrored layout -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Opponent Hand (top, above their field) -->
                    <Border Grid.Row="0" Style="{StaticResource ZoneBorder}" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="OPPONENT HAND" Style="{StaticResource ZoneLabel}"/>
                                <TextBlock x:Name="OpponentHandCount" Text="(5)" FontSize="11" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,8"/>
                            </StackPanel>
                            <ItemsControl x:Name="OpponentHandPanel">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    
                    <!-- Opponent Field Area -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left Side: Champion + Material Deck -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="OPPONENT" Style="{StaticResource ZoneLabel}"/>
                            <TextBlock x:Name="OpponentNameText" Text="Player 2" FontSize="12" FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            
                            <!-- Champion Display -->
                            <Border x:Name="OpponentChampionBorder" Style="{StaticResource CardBorder}" 
                                    Width="90" Height="126" HorizontalAlignment="Center"
                                    MouseLeftButtonDown="Card_Click" Tag="OpponentChampion">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="6,6,0,0" Margin="3,3,3,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#2D1B4E" Offset="0"/>
                                                <GradientStop Color="#1A1A2E" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border Grid.Row="1" Background="#1A1A2E" CornerRadius="0,0,6,6" Padding="4,3">
                                        <StackPanel>
                                            <TextBlock x:Name="OpponentChampionName" Text="Champion" FontSize="8" 
                                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                                       TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Border Background="{StaticResource AccentRedBrush}" CornerRadius="2" Padding="3,1" Margin="0,0,3,0">
                                                    <TextBlock x:Name="OpponentChampionPower" Text="0" FontSize="8" Foreground="White" FontWeight="Bold"/>
                                                </Border>
                                                <Border Background="{StaticResource AccentGreenBrush}" CornerRadius="2" Padding="3,1">
                                                    <TextBlock x:Name="OpponentChampionLife" Text="20" FontSize="8" Foreground="White" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text=" LV" FontSize="7" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="OpponentLevelText" Text="1" FontSize="8" FontWeight="Bold" 
                                                           Foreground="{StaticResource AccentPurpleBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            
                            <!-- Material Deck (face-down stack) -->
                            <Border Style="{StaticResource ZoneBorder}" Margin="0,8,0,0" Padding="6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="MATERIAL" Style="{StaticResource ZoneLabel}" Margin="0"/>
                                        <TextBlock x:Name="OpponentMaterialDeckCount" Text="(0)" FontSize="9" 
                                                   Foreground="{StaticResource AccentPurpleBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Face-down card stack visual -->
                                    <Grid Width="70" Height="98" HorizontalAlignment="Center">
                                        <Border x:Name="OpponentMaterialDeckVisual" CornerRadius="4" 
                                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#2D1B4E" Offset="0"/>
                                                    <GradientStop Color="#1A1A2E" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="🂠" FontSize="32" HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" Foreground="{StaticResource AccentPurpleBrush}"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        
                        <!-- Center: Memory (top) + Field -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Memory (top of opponent's field, closest to center) - face-down cards used to pay costs -->
                            <Border Grid.Row="0" Style="{StaticResource ZoneBorder}" Padding="8,6" Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="MEMORY" Style="{StaticResource ZoneLabel}" VerticalAlignment="Center" Margin="0"/>
                                        <TextBlock x:Name="OpponentMemoryCount" Text="(0)" FontSize="11" 
                                                   Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="90">
                                        <ItemsControl x:Name="OpponentMemoryPanel">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                            
                            <!-- Field -->
                            <Border Grid.Row="1" Style="{StaticResource ZoneBorder}">
                                <StackPanel>
                                    <TextBlock Text="FIELD" Style="{StaticResource ZoneLabel}"/>
                                    <ItemsControl x:Name="OpponentFieldPanel">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Right Side: Banishment, Deck, Graveyard -->
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <!-- Banishment (face-up, shows top card) -->
                            <Border Style="{StaticResource ZoneBorder}" Margin="0,0,0,6" Padding="6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="BANISH" Style="{StaticResource ZoneLabel}" Margin="0"/>
                                        <TextBlock x:Name="OpponentBanishmentCount" Text="(0)" FontSize="9" 
                                                   Foreground="{StaticResource AccentRedBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Width="98" Height="70" HorizontalAlignment="Center">
                                        <Grid.LayoutTransform>
                                            <RotateTransform Angle="-90"/>
                                        </Grid.LayoutTransform>
                                        <!-- Empty state -->
                                        <Border x:Name="OpponentBanishmentEmpty" CornerRadius="4" 
                                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                                Background="{StaticResource TertiaryDarkBrush}" Width="70" Height="98">
                                            <TextBlock Text="✕" FontSize="24" HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.3"/>
                                        </Border>
                                        <!-- Top card display -->
                                        <Border x:Name="OpponentBanishmentTopCard" Visibility="Collapsed" CornerRadius="4" 
                                                BorderThickness="1" BorderBrush="{StaticResource AccentRedBrush}" ClipToBounds="True" Width="70" Height="98"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Main Deck (card backs) -->
                            <Border Style="{StaticResource ZoneBorder}" Margin="0,0,0,6" Padding="6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="DECK" Style="{StaticResource ZoneLabel}" Margin="0"/>
                                        <TextBlock x:Name="OpponentDeckCount" Text="(55)" FontSize="9" 
                                                   Foreground="{StaticResource AccentGoldBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Width="70" Height="98" HorizontalAlignment="Center">
                                        <Border x:Name="OpponentDeckVisual" CornerRadius="4" 
                                                BorderThickness="1" BorderBrush="{StaticResource AccentGoldBrush}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#1a1a2e" Offset="0"/>
                                                    <GradientStop Color="#16213e" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="🂠" FontSize="32" HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" Foreground="{StaticResource AccentGoldBrush}"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Graveyard (face-up, shows top card) -->
                            <Border Style="{StaticResource ZoneBorder}" Padding="6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="GRAVE" Style="{StaticResource ZoneLabel}" Margin="0"/>
                                        <TextBlock x:Name="OpponentGraveyardCount" Text="(0)" FontSize="9" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Width="70" Height="98" HorizontalAlignment="Center">
                                        <!-- Empty state -->
                                        <Border x:Name="OpponentGraveyardEmpty" CornerRadius="4" 
                                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                                Background="{StaticResource TertiaryDarkBrush}">
                                            <TextBlock Text="☠" FontSize="24" HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.3"/>
                                        </Border>
                                        <!-- Top card display -->
                                        <Border x:Name="OpponentGraveyardTopCard" Visibility="Collapsed" CornerRadius="4" 
                                                BorderThickness="1" BorderBrush="{StaticResource TextSecondaryBrush}" ClipToBounds="True"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
                
                <!-- Center Divider -->
                <Border Grid.Row="1" Height="2" Background="{StaticResource BorderBrush}" Margin="0,12" CornerRadius="1"/>
                
                <!-- Player Area (Bottom) -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Main Field Area -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left Side: Champion + Material Deck -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="YOU" Style="{StaticResource ZoneLabel}"/>
                            <TextBlock x:Name="PlayerNameText" Text="Player 1" FontSize="12" FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            
                            <!-- Champion Display -->
                            <Border x:Name="PlayerChampionBorder" Style="{StaticResource CardBorder}" 
                                    Width="90" Height="126" HorizontalAlignment="Center"
                                    MouseLeftButtonDown="Card_Click" Tag="PlayerChampion">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="6,6,0,0" Margin="3,3,3,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#1B4D2E" Offset="0"/>
                                                <GradientStop Color="#1A1A2E" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border Grid.Row="1" Background="#1A1A2E" CornerRadius="0,0,6,6" Padding="4,3">
                                        <StackPanel>
                                            <TextBlock x:Name="PlayerChampionName" Text="Champion" FontSize="8" 
                                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                                       TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Border Background="{StaticResource AccentRedBrush}" CornerRadius="2" Padding="3,1" Margin="0,0,3,0">
                                                    <TextBlock x:Name="PlayerChampionPower" Text="0" FontSize="8" Foreground="White" FontWeight="Bold"/>
                                                </Border>
                                                <Border Background="{StaticResource AccentGreenBrush}" CornerRadius="2" Padding="3,1">
                                                    <TextBlock x:Name="PlayerChampionLife" Text="20" FontSize="8" Foreground="White" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text=" LV" FontSize="7" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="PlayerLevelText" Text="1" FontSize="8" FontWeight="Bold" 
                                                           Foreground="{StaticResource AccentPurpleBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            
                            <!-- Material Deck (face-down stack) -->
                            <Border Style="{StaticResource ZoneBorder}" Margin="0,8,0,0" Cursor="Hand" Padding="6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="MATERIAL" Style="{StaticResource ZoneLabel}" Margin="0"/>
                                        <TextBlock x:Name="PlayerMaterialDeckCount" Text="(0)" FontSize="9" 
                                                   Foreground="{StaticResource AccentPurpleBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Face-down card stack visual -->
                                    <Grid Width="70" Height="98" HorizontalAlignment="Center">
                                        <Border x:Name="PlayerMaterialDeckVisual" CornerRadius="4" 
                                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#2D1B4E" Offset="0"/>
                                                    <GradientStop Color="#1A1A2E" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="🂠" FontSize="32" HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" Foreground="{StaticResource AccentPurpleBrush}"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        
                        <!-- Center: Field + Memory -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Field -->
                            <Border x:Name="PlayerFieldZone" Grid.Row="0" Style="{StaticResource ZoneBorder}" Margin="0,0,0,8"
                                    AllowDrop="True" Drop="PlayerField_Drop" DragOver="Zone_DragOver" DragLeave="Zone_DragLeave">
                                <StackPanel>
                                    <TextBlock Text="FIELD" Style="{StaticResource ZoneLabel}"/>
                                    <ItemsControl x:Name="PlayerFieldPanel">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            
                            <!-- Memory (bottom of field) - face-down cards used to pay costs -->
                            <Border x:Name="PlayerMemoryZone" Grid.Row="1" Style="{StaticResource ZoneBorder}" Padding="8,6"
                                    AllowDrop="True" Drop="PlayerMemory_Drop" DragOver="Zone_DragOver" DragLeave="Zone_DragLeave">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="MEMORY" Style="{StaticResource ZoneLabel}" VerticalAlignment="Center" Margin="0"/>
                                        <TextBlock x:Name="PlayerMemoryCount" Text="(0)" FontSize="11" 
                                                   Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="90">
                                        <ItemsControl x:Name="PlayerMemoryPanel">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Right Side: Banishment, Deck, Graveyard -->
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <!-- Banishment (face-up, shows top card) -->
                            <Border x:Name="PlayerBanishmentZone" Style="{StaticResource ZoneBorder}" Margin="0,0,0,6" Padding="6"
                                    AllowDrop="True" Drop="PlayerBanishment_Drop" DragOver="Zone_DragOver" DragLeave="Zone_DragLeave">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="BANISH" Style="{StaticResource ZoneLabel}" Margin="0"/>
                                        <TextBlock x:Name="PlayerBanishmentCount" Text="(0)" FontSize="9" 
                                                   Foreground="{StaticResource AccentRedBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Width="98" Height="70" HorizontalAlignment="Center">
                                        <Grid.LayoutTransform>
                                            <RotateTransform Angle="-90"/>
                                        </Grid.LayoutTransform>
                                        <!-- Empty state -->
                                        <Border x:Name="PlayerBanishmentEmpty" CornerRadius="4" 
                                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                                Background="{StaticResource TertiaryDarkBrush}" Width="70" Height="98">
                                            <TextBlock Text="✕" FontSize="24" HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.3"/>
                                        </Border>
                                        <!-- Top card display -->
                                        <Border x:Name="PlayerBanishmentTopCard" Visibility="Collapsed" CornerRadius="4" 
                                                BorderThickness="1" BorderBrush="{StaticResource AccentRedBrush}" ClipToBounds="True" Width="70" Height="98"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Main Deck (card backs) -->
                            <Border Style="{StaticResource ZoneBorder}" Margin="0,0,0,6" Padding="6"
                                    MouseLeftButtonDown="Deck_Click" Cursor="Hand">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="DECK" Style="{StaticResource ZoneLabel}" Margin="0"/>
                                        <TextBlock x:Name="PlayerDeckCount" Text="(55)" FontSize="9" 
                                                   Foreground="{StaticResource AccentGoldBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Width="70" Height="98" HorizontalAlignment="Center">
                                        <Border x:Name="PlayerDeckVisual" CornerRadius="4" 
                                                BorderThickness="1" BorderBrush="{StaticResource AccentGoldBrush}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#1a1a2e" Offset="0"/>
                                                    <GradientStop Color="#16213e" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="🂠" FontSize="32" HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" Foreground="{StaticResource AccentGoldBrush}"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Graveyard (face-up, shows top card) -->
                            <Border x:Name="PlayerGraveyardZone" Style="{StaticResource ZoneBorder}" Padding="6"
                                    AllowDrop="True" Drop="PlayerGraveyard_Drop" DragOver="Zone_DragOver" DragLeave="Zone_DragLeave">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="GRAVE" Style="{StaticResource ZoneLabel}" Margin="0"/>
                                        <TextBlock x:Name="PlayerGraveyardCount" Text="(0)" FontSize="9" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Width="70" Height="98" HorizontalAlignment="Center">
                                        <!-- Empty state -->
                                        <Border x:Name="PlayerGraveyardEmpty" CornerRadius="4" 
                                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                                Background="{StaticResource TertiaryDarkBrush}">
                                            <TextBlock Text="☠" FontSize="24" HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.3"/>
                                        </Border>
                                        <!-- Top card display -->
                                        <Border x:Name="PlayerGraveyardTopCard" Visibility="Collapsed" CornerRadius="4" 
                                                BorderThickness="1" BorderBrush="{StaticResource TextSecondaryBrush}" ClipToBounds="True"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Hand (below the entire field) -->
                    <Border x:Name="PlayerHandZone" Grid.Row="1" Style="{StaticResource ZoneBorder}" Margin="0,8,0,0"
                            AllowDrop="True" Drop="PlayerHand_Drop" DragOver="Zone_DragOver" DragLeave="Zone_DragLeave">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="HAND" Style="{StaticResource ZoneLabel}"/>
                                <TextBlock x:Name="PlayerHandCount" Text="(5)" FontSize="11" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,8"/>
                            </StackPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="PlayerHandPanel">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            
            <!-- RIGHT PANEL: Card Preview + Game Log -->
            <Border Grid.Column="2" Background="{StaticResource SecondaryDarkBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="12,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="160"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="CARD PREVIEW" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                    
                    <!-- Card Image Preview -->
                    <Border x:Name="CardPreviewPanel" Grid.Row="1" 
                            Background="{StaticResource TertiaryDarkBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <!-- Placeholder when no card hovered -->
                            <StackPanel x:Name="CardPreviewPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🂠" FontSize="48" Foreground="{StaticResource TextSecondaryBrush}" 
                                           HorizontalAlignment="Center" Opacity="0.3"/>
                                <TextBlock Text="Hover over a card" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" 
                                           HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.5"/>
                            </StackPanel>
                            
                            <!-- Card Image (scales to fit while maintaining aspect ratio) -->
                            <Image x:Name="HoverCardImage" Visibility="Collapsed" 
                                   Stretch="Uniform" 
                                   VerticalAlignment="Top"
                                   Margin="4"/>
                        </Grid>
                    </Border>
                    
                    <!-- Card Info -->
                    <Border x:Name="CardPreviewInfo" Grid.Row="2" Visibility="Collapsed"
                            Background="{StaticResource TertiaryDarkBrush}" CornerRadius="8" 
                            Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="HoverCardName" Text="Card Name" 
                                       FontSize="14" FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="HoverCardType" Text="Type" 
                                           FontSize="10" Foreground="{StaticResource AccentPurpleBrush}"/>
                                <TextBlock Text=" • " FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="HoverCardElement" Text="Element" 
                                           FontSize="10" Foreground="{StaticResource AccentBlueBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Background="{StaticResource AccentBlueBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Cost " FontSize="9" Foreground="White"/>
                                        <TextBlock x:Name="HoverCardCost" Text="0" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="HoverStatsPanel" Background="{StaticResource PrimaryDarkBrush}" CornerRadius="4" Padding="6,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="HoverCardPower" Text="0" FontSize="9" FontWeight="Bold" 
                                                   Foreground="{StaticResource AccentRedBrush}"/>
                                        <TextBlock Text=" / " FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="HoverCardLife" Text="0" FontSize="9" FontWeight="Bold" 
                                                   Foreground="{StaticResource AccentGreenBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="HoverCardEffect" Text="" FontSize="10" 
                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                       TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="80"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Game Log Header -->
                    <TextBlock Grid.Row="3" Text="GAME LOG" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,8"/>
                    
                    <!-- Game Log -->
                    <Border Grid.Row="4" Background="{StaticResource TertiaryDarkBrush}" 
                            CornerRadius="8" Padding="10">
                        <ScrollViewer x:Name="GameLogScroller" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="GameLogText" Text="" FontSize="10" 
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
